@ scratch-template: v1
@ family: dproc_rsr
@ op: register_shifted_register
@ algorithm: conditional-variable-shift-unrolled
@ flags: clobber_nzcv
@ kind: whole
@ temps: t0,t1
@ inputs: %rm,%rs,%rn
@ outputs: %rd
@ placeholders: %variable_shift_steps,%shift_overflow_fixup,%dproc_result_line
@ line-placeholders: %variable_shift_steps,%shift_overflow_fixup,%dproc_result_line
@ predication: wrap guards/predicated_branch_guard.s.tmpl
@ notes: t0 is value, t1 is low byte amount. Steps use TST and conditional shifts.

mov %t0, %rm
and %t1, %rs, #255
%variable_shift_steps
%shift_overflow_fixup
%dproc_result_line
