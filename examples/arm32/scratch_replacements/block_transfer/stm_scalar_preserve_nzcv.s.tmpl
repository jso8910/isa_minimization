@ scratch-template: v1
@ family: block_transfer
@ op: stm
@ algorithm: scalar-stores
@ flags: preserve_nzcv
@ kind: whole
@ temps:
@ inputs: %base and stored registers
@ outputs: memory and optional %base
@ placeholders: %block_transfer_steps,%block_writeback
