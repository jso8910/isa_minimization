@ scratch-template: v1
@ family: mull
@ op: add64
@ algorithm: boolean-carry
@ flags: preserve_nzcv
@ kind: fragment
@ temps: t0,t1,t2
@ inputs: %lo_src,%hi_src,%lo_dst,%hi_dst
@ outputs: %lo_dst,%hi_dst
@ predication: wrap guards/predicated_branch_guard.s.tmpl
@ notes: Adds hi_src:lo_src into hi_dst:lo_dst without reading or writing flags.

mov %t0, %lo_dst
add %lo_dst, %lo_dst, %lo_src
and %t1, %t0, %lo_src
orr %t0, %t0, %lo_src
mvn %t2, %lo_dst
and %t0, %t0, %t2
orr %t1, %t1, %t0
mov %t1, %t1, lsr #31
add %hi_dst, %hi_dst, %hi_src
add %hi_dst, %hi_dst, %t1
