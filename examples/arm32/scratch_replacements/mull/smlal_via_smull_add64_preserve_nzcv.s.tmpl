@ scratch-template: v1
@ family: mull
@ op: smlal
@ algorithm: smull-plus-branchless-add64
@ flags: preserve_nzcv
@ kind: whole
@ temps: t0,t1,t2,t3,t4
@ inputs: %rm,%rs,%rdlo,%rdhi
@ outputs: %rdlo,%rdhi
@ placeholders: %smull
@ requires: smull or preserve-NZCV smull scratch replacement
@ predication: wrap guards/predicated_branch_guard.s.tmpl
@ notes: Saves the 64-bit accumulator before SMULL overwrites rdhi:rdlo.

mov %t0, %rdlo
mov %t1, %rdhi
%smull %rdlo, %rdhi, %rm, %rs
mov %t2, %rdlo
add %rdlo, %rdlo, %t0
and %t3, %t2, %t0
orr %t2, %t2, %t0
mvn %t4, %rdlo
and %t2, %t2, %t4
orr %t3, %t3, %t2
mov %t3, %t3, lsr #31
add %rdhi, %rdhi, %t1
add %rdhi, %rdhi, %t3
