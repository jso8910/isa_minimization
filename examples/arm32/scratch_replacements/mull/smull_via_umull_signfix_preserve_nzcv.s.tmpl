@ scratch-template: v1
@ family: mull
@ op: smull
@ algorithm: umull-plus-branchless-sign-fix
@ flags: preserve_nzcv
@ kind: whole
@ temps: t0,t1
@ inputs: %rm,%rs
@ outputs: %rdlo,%rdhi
@ placeholders: %umull
@ requires: umull or preserve-NZCV umull scratch replacement
@ predication: wrap guards/predicated_branch_guard.s.tmpl
@ notes: Signed high word = unsigned high word minus sign(rm)*rs minus sign(rs)*rm.

%umull %rdlo, %rdhi, %rm, %rs
mov %t0, %rm, asr #31
and %t0, %t0, %rs
sub %rdhi, %rdhi, %t0
mov %t1, %rs, asr #31
and %t1, %t1, %rm
sub %rdhi, %rdhi, %t1
